# ==============================================================================
# Kanjikuzhi Local Development Intelligence Platform (KLIP)
# Environment Configuration Template (.env.example)
#
# IMPORTANT (DPDP Act 2023 Compliance):
# Never commit actual secret keys or production database credentials to git.
# Copy this file to '.env' and populate with local development secrets.
# ==============================================================================

# Application Environment ('development', 'testing', 'production')
APP_ENV=development
DEBUG=True
API_V1_PREFIX=/api/v1
PROJECT_NAME="KLIP - Kanjikuzhi Local Development Intelligence Platform"

# ------------------------------------------------------------------------------
# PostgreSQL Database (PostGIS 3.4 + pgvector + pgcrypto enabled)
# ------------------------------------------------------------------------------
# If running via local Windows PostgreSQL on port 5432:
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=klip_db

# Async URL for FastAPI (asyncpg)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Sync URL for Alembic migrations and ETL CLI scripts (psycopg2)
DATABASE_URL_SYNC=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}

# Database Connection Pool Settings
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# DPDP Act 2023 Cryptographic Secrets (PII Vault & Peppered Hashing)
# ------------------------------------------------------------------------------
# 256-bit Base64-encoded secret for AES-256-GCM column encryption in pii_vault
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
PII_AES_KEY=r4nd0m_s3cr3t_aes_256_k3y_m4st3r_ch4ng3_m3_in_pr0d=

# High-entropy salt/pepper for deterministic phone and sensitive record hashing (SHA-256)
# Prevents dictionary attacks on Indian mobile numbers and disease cases
PII_PEPPER_KEY=klip_dpdp_salt_pepper_2026_kanjikuzhi_super_secret_string

# ------------------------------------------------------------------------------
# Authentication & JWT Configuration (Citizen OTP & Admin RBAC)
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=generate_a_super_secret_jwt_key_here_for_klip_auth_tokens
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Mock OTP Mode (Set True for development without SMS Gateway charges)
# When True, OTP is always '123456' and printed in server logs
MOCK_SMS_OTP=True

# ------------------------------------------------------------------------------
# Redis Cache & Background Task Queue
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# ------------------------------------------------------------------------------
# Intelligence Layer (Local vLLM / Ollama & Embeddings)
# ------------------------------------------------------------------------------
# Private self-hosted LLM endpoint (Zero Cloud Leakage)
VLLM_API_BASE=http://localhost:8000/v1
VLLM_API_KEY=not-needed-for-local
VLLM_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct

# Multilingual Embedding Model for Malayalam Scheme Retrieval
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_DIMENSION=1024

# Speech-to-Text Model for Malayalam Voice Grievances
WHISPER_MODEL_SIZE=base
WHISPER_LANGUAGE=ml

# ------------------------------------------------------------------------------
# CORS & Web Client Settings
# ------------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173
